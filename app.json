{
  "expo": {
    "name": "XSR Companion",
    "slug": "xsr-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12161C"
    },
    "android": {
      "package": "com.femin.xsrcompanion",
      "permissions": ["BLUETOOTH_SCAN", "BLUETOOTH_CONNECT", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#12161C"
      }
    },
    "extra": {
      "eas": {
        "projectId": "4669471e-19c1-413f-bccd-f51b00f65323"
      }
    },
    "plugins": [
  ["react-native-ble-plx", { "bluetoothAlwaysPermission": "Connect to your motorcycle over Bluetooth." }]
]
  }
}
